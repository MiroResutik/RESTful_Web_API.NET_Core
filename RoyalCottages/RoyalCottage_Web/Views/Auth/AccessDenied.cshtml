@{
    ViewData["Title"] = "Access Denied";
}

<div class="access-denied-page">

    <div class="access-denied-card">

        <!-- Decorative Header -->
        <div class="access-denied-header">
            <div class="security-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <span class="security-label">SECURITY NOTICE</span>

            <h1>Access Denied</h1>

            <p>
                You don't have permission to access this page.
            </p>
        </div>

        <!-- Content -->
        <div class="access-denied-body">

            <div class="warning-panel">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <h6>Restricted Area</h6>
                    <p>
                        This resource is protected and requires additional
                        permissions. If you believe this is a mistake,
                        please contact your administrator.
                    </p>
                </div>
            </div>

            <div class="access-denied-message">
                <i class="bi bi-info-circle"></i>
                <span>
                    You can return to the homepage or go back to your
                    previous activity.
                </span>
            </div>

            <!-- Action Buttons -->
            <div class="access-denied-actions">

                <a asp-action="Index"
                   asp-controller="Home"
                   class="btn-access-home">
                    <i class="bi bi-house-door-fill"></i>
                    Return to Home
                    <i class="bi bi-arrow-right"></i>
                </a>

                <button type="button"
                        class="btn-access-back"
                        onclick="history.back()">
                    <i class="bi bi-arrow-left"></i>
                    Go Back
                </button>

            </div>

            <div class="access-denied-footer">
                <i class="bi bi-shield-check"></i>
                RoyalCottage Security
            </div>

        </div>

    </div>

</div>

