@using RoyalCottage_DTO
@model IEnumerable<CottageDTO>

@{
    ViewData["Title"] = "Luxury Cottage List";

    var cottages = Model?.ToList() ?? new List<CottageDTO>();

    var totalCottages = cottages.Count;
    var startingRate = totalCottages > 0 ? cottages.Min(c => c.Rate) : 0;
    var maxOccupancy = totalCottages > 0 ? cottages.Max(c => c.Occupancy) : 0;
    var totalSqMeters = cottages.Sum(c => c.SqMeters);
}

<div class="container my-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Cottage Management</h2>
            <p class="text-muted mb-0">Manage your cottage listings</p>
        </div>
        <a asp-area=""
           asp-controller="Cottage"
           asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Add New Cottage
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
            <h5>No Cottages Available</h5>
            <p class="mb-3">Get started by creating your first cottage.</p>
            <a href="#" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Create Cottage
            </a>
        </div>
    }
    else
    {

        <!-- Cottage Table -->
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Details</th>
                                <th>Rate</th>
                                <th>Occupancy</th>
                                <th>SqMeter</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cottage in cottages)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(cottage.ImageUrl))
                                        {
                                            <img src="@cottage.ImageUrl" alt="@cottage.Name" class="rounded" style="width: 60px; height: 45px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white"
                                            style="width: 60px; height: 45px;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <strong>@cottage.Name</strong>
                                    </td>
                                    <td class="align-middle">
                                        <small class="text-muted">
                                            @if(string.IsNullOrEmpty(cottage.Details))
                                            {
                                                <span class="fst-italic">No Details</span>
                                            }
                                            else
                                            {
                                                @(cottage.Details.Length >50 ? cottage.Details.Substring(0,50) + "..." : cottage.Details)
                                            }
                                        </small>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-success">£@cottage.Rate.ToString("N0")</span>
                                    </td>
                                    <td class="align-middle">
                                        <i class="bi bi-people me-1"></i>@cottage.Occupancy
                                    </td>
                                    <td class="align-middle">
                                        <i class="bi bi-rulers me-1"></i>@cottage.SqMeters
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group btn-group-sm">

                                            <a href="#"
                                            class="btn btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="#"
                                            class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    <!-- Summary -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="text-primary">Count</h5>
                    <small class="text-muted">@totalCottages</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="text-success">Starting Price</h5>
                    <small class="text-muted">£ @startingRate</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="text-info">Total SqMeter</h5>
                    <small class="text-muted">@totalSqMeters</small>
                </div>
            </div>
        </div>
    </div>
    
</div>

<style>
    .object-fit-cover {
        object-fit: cover;
    }
</style>
