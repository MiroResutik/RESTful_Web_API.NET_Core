
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RoyalCottage_Web</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RoyalCottage_Web.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg luxury-navbar">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand luxury-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house-heart-fill"></i>

                    <span>Royal<span class="brand-gold">Cottage</span></span>

                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Cottage"
                               asp-action="Index">

                                <i class="bi bi-house-gear me-1"></i>
                                Cottage Management

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">

                                <i class="bi bi-shield-lock me-1"></i>
                                Privacy

                            </a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                            <a class="nav-contact"
                               href="mailto:hello@dotnetmastery.com">

                                <i class="bi bi-envelope me-2"></i>
                                Contact Us

                            </a>
                        </li>


                    </ul>
                    @if(User.Identity.IsAuthenticated)
                        {

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">

                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name

                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-action="Logout" asp-controller="Auth">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </a>
                                </li>
                                
                            </ul>
                        </li>
                        }
                        else
                        {
                        <ul class="navbar-nav">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Auth"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Auth"
                                   asp-action="Register">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Register

                                </a>
                            </li>
                         

                        </ul>
                        }
      
                </div>

            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="main-content">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="luxury-footer">

        <div class="container">

            <div class="row gy-4 align-items-center">

                <!-- Footer Brand -->
                <div class="col-md-6">

                    <a class="footer-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-house-heart-fill me-2"></i>
                        Royal<span>Cottage</span>

                    </a>

                    <p class="footer-description mb-0">
                        Discover exceptional cottages and experience
                        comfort, elegance and unforgettable stays.
                    </p>

                </div>

                <!-- Footer Links -->
                <div class="col-md-6 text-md-end">

                    <div class="footer-links">

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>

                        <a asp-area=""
                           asp-controller="Cottage"
                           asp-action="Index">
                            Cottages
                        </a>

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Privacy">
                            Privacy
                        </a>

                    </div>

                    <p class="footer-copyright mb-0">
                        &copy; @DateTime.Now.Year RoyalCottage_Web.
                        All rights reserved.
                    </p>

                </div>

            </div>

            <div class="footer-divider"></div>

            <div class="text-center footer-bottom">
                <i class="bi bi-gem me-2"></i>
                Experience the Art of Luxury Living
            </div>

        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


