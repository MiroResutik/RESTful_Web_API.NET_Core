@model RoyalCottage_DTO.CottageDTO

@{
    ViewData["Title"] = "Delete Cottage";
}

<div class="rc-delete-page">

    <div class="container py-4">

        <div class="row justify-content-center">

            <div class="col-xl-8 col-lg-9">

                <!-- PAGE HEADER -->
                <div class="rc-delete-header mb-4">

                    <div class="rc-delete-header-content">

                        <div class="rc-delete-icon">
                            <i class="bi bi-trash3-fill"></i>
                        </div>

                        <div>
                            <span class="rc-delete-eyebrow">
                                ROYAL COTTAGE ADMINISTRATION
                            </span>

                            <h1>Delete Cottage</h1>

                            <p>
                                Review the cottage details before confirming deletion.
                            </p>
                        </div>

                    </div>

                </div>

                <!-- WARNING MESSAGE -->
                <div class="rc-delete-warning mb-4">

                    <div class="rc-delete-warning-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <div>
                        <h5>Are you sure you want to delete this cottage?</h5>

                        <p>
                            This action cannot be undone. Once deleted, this cottage
                            listing will be permanently removed.
                        </p>
                    </div>

                </div>

                <!-- DELETE CARD -->
                <div class="rc-delete-card">

                    <div class="rc-delete-card-header">

                        <div>
                            <h4>
                                <i class="bi bi-house-heart me-2"></i>
                                Cottage Information
                            </h4>

                            <p>Review the property information below.</p>
                        </div>

                        <span class="rc-delete-badge">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Deletion
                        </span>

                    </div>

                    <div class="rc-delete-card-body">

                        <form asp-action="Delete" method="post"
                              onsubmit="return confirm('Are you sure you want to permanently delete this cottage?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <!-- COTTAGE NAME -->
                            <div class="mb-4">

                                <label asp-for="Name" class="rc-delete-label">
                                    Cottage Name
                                </label>

                                <div class="rc-delete-input-group">

                                    <i class="bi bi-house-door"></i>

                                    <input asp-for="Name"
                                           class="form-control"
                                           readonly />

                                </div>

                            </div>

                            <!-- DETAILS -->
                            <div class="mb-4">

                                <label asp-for="Details" class="rc-delete-label">
                                    Cottage Description
                                </label>

                                <textarea asp-for="Details"
                                          class="form-control rc-delete-textarea"
                                          rows="5"
                                          readonly></textarea>

                            </div>

                            <!-- RATE AND OCCUPANCY -->
                            <div class="row">

                                <div class="col-md-6 mb-4">

                                    <label asp-for="Rate" class="rc-delete-label">
                                        Nightly Rate
                                    </label>

                                    <div class="input-group rc-delete-input-group">

                                        <span class="input-group-text">£</span>

                                        <input asp-for="Rate"
                                               type="number"
                                               step="0.01"
                                               class="form-control"
                                               readonly />

                                    </div>

                                </div>

                                <div class="col-md-6 mb-4">

                                    <label asp-for="Occupancy" class="rc-delete-label">
                                        Maximum Occupancy
                                    </label>

                                    <div class="rc-delete-input-group">

                                        <i class="bi bi-people"></i>

                                        <input asp-for="Occupancy"
                                               type="number"
                                               class="form-control"
                                               readonly />

                                    </div>

                                </div>

                            </div>

                            <!-- PROPERTY SIZE -->
                            <div class="mb-4">

                                <label asp-for="SqMeters" class="rc-delete-label">
                                    Property Size (Square Metres)
                                </label>

                                <div class="rc-delete-input-group">

                                    <i class="bi bi-rulers"></i>

                                    <input asp-for="SqMeters"
                                           type="number"
                                           class="form-control"
                                           readonly />

                                    <span class="input-group-text">m²</span>

                                </div>

                            </div>

                            <!-- IMAGE URL -->
                            <div class="mb-4">

                                <label asp-for="ImageUrl" class="rc-delete-label">
                                    Cottage Image URL
                                </label>

                                <div class="rc-delete-input-group">

                                    <i class="bi bi-image"></i>

                                    <input asp-for="ImageUrl"
                                           class="form-control"
                                           readonly />

                                </div>

                            </div>

                            <!-- IMAGE PREVIEW -->
                            <div class="rc-delete-image-section mb-4">

                                <div class="rc-delete-image-heading">
                                    <i class="bi bi-camera me-2"></i>
                                    Cottage Image
                                </div>

                                <div class="rc-delete-image-preview">

                                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl"
                                             alt="@Model.Name"
                                             onerror="this.classList.add('d-none'); document.getElementById('deleteImagePlaceholder').classList.remove('d-none');" />

                                        <div id="deleteImagePlaceholder"
                                             class="rc-delete-image-placeholder d-none">

                                            <i class="bi bi-image"></i>
                                            <span>Image unavailable</span>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rc-delete-image-placeholder">

                                            <i class="bi bi-image"></i>
                                            <span>No image available</span>

                                        </div>
                                    }

                                </div>

                            </div>

                            <!-- DELETE CONFIRMATION -->
                            <div class="rc-delete-confirmation">

                                <i class="bi bi-shield-exclamation"></i>

                                <span>
                                    Please confirm that you want to permanently remove
                                    this cottage from your listings.
                                </span>

                            </div>

                            <!-- ACTION BUTTONS -->
                            <div class="rc-delete-actions">

                                <a asp-action="Index"
                                   class="rc-delete-cancel-btn">

                                    <i class="bi bi-arrow-left me-2"></i>
                                    Cancel

                                </a>

                                <button type="submit"
                                        class="rc-delete-submit-btn">

                                    <i class="bi bi-trash3 me-2"></i>
                                    Delete Cottage

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
