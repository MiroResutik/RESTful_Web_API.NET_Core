@using RoyalCottage_DTO
@model IEnumerable<CottageDTO>

@{
    ViewData["Title"] = "RoyalCottage - Luxury Cottage Collection";

    var cottages = Model?.ToList() ?? new List<CottageDTO>();

    var totalCottages = cottages.Count;
    var startingRate = totalCottages > 0 ? cottages.Min(c => c.Rate) : 0;
    var maxOccupancy = totalCottages > 0 ? cottages.Max(c => c.Occupancy) : 0;
    var totalSqMeters = cottages.Sum(c => c.SqMeters);
}

<!-- Hero Carousel -->
<section id="royalCottageCarousel"
         class="carousel slide carousel-fade rc-hero"
         data-bs-ride="carousel"
         data-bs-interval="6000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#royalCottageCarousel"
                data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Slide 1"></button>

        <button type="button" data-bs-target="#royalCottageCarousel"
                data-bs-slide-to="1" aria-label="Slide 2"></button>

        <button type="button" data-bs-target="#royalCottageCarousel"
                data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">

        <!-- Slide 1 -->
        <div class="carousel-item active">
            <div class="rc-hero-slide rc-hero-one">
                <div class="rc-hero-content">

                    <span class="rc-hero-eyebrow">
                        <i class="bi bi-house-heart"></i>
                        WELCOME TO ROYALCOTTAGE
                    </span>

                    <h1>Escape to Something Extraordinary</h1>

                    <p>
                        Discover beautiful cottages, peaceful surroundings
                        and the freedom to slow down and enjoy life.
                    </p>

                    <a href="#cottage-listings" class="rc-btn-light">
                        Explore Our Cottages
                        <i class="bi bi-arrow-down-circle"></i>
                    </a>

                </div>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item">
            <div class="rc-hero-slide rc-hero-two">
                <div class="rc-hero-content">

                    <span class="rc-hero-eyebrow">
                        <i class="bi bi-stars"></i>
                        YOUR TIME TO UNWIND
                    </span>

                    <h1>Reconnect With What Matters</h1>

                    <p>
                        Step away from everyday distractions, put your devices
                        aside and enjoy a refreshing digital detox.
                    </p>

                    <a href="#digital-detox" class="rc-btn-light">
                        Discover Digital Detox
                        <i class="bi bi-arrow-down-circle"></i>
                    </a>

                </div>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-item">
            <div class="rc-hero-slide rc-hero-three">
                <div class="rc-hero-content">

                    <span class="rc-hero-eyebrow">
                        <i class="bi bi-calendar-heart"></i>
                        YOUR PERFECT GETAWAY
                    </span>

                    <h1>Make Time for Yourself</h1>

                    <p>
                        Find your perfect cottage and enjoy a slower pace
                        surrounded by comfort, tranquillity and nature.
                    </p>

                    <a href="#cottage-listings" class="rc-btn-light">
                        View Cottage Collection
                        <i class="bi bi-arrow-down-circle"></i>
                    </a>

                </div>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button"
            data-bs-target="#royalCottageCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>

    <button class="carousel-control-next" type="button"
            data-bs-target="#royalCottageCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>

</section>


<!-- Main Content -->
<div class="rc-home-container" id="cottage-listings">

    <!-- Page Heading -->
    <section class="rc-section-heading">

        <span class="rc-section-eyebrow">
            DISCOVER ROYALCOTTAGE
        </span>

        <h2>
            <i class="bi bi-house-heart-fill"></i>
            Our Exclusive Cottage Collection
        </h2>

        <p>
            Discover handpicked cottages designed for comfort,
            relaxation and unforgettable escapes.
        </p>

        <div class="rc-heading-divider">
            <span></span>
            <i class="bi bi-gem"></i>
            <span></span>
        </div>

    </section>


    <!-- Digital Detox Section -->
    <section class="rc-detox-section" id="digital-detox">

        <div class="rc-detox-icon">
            <i class="bi bi-phone"></i>
            <span class="rc-detox-cross">
                <i class="bi bi-slash-circle-fill"></i>
            </span>
        </div>

        <div class="rc-detox-content">

            <span class="rc-detox-eyebrow">
                SLOW DOWN. SWITCH OFF. RECONNECT.
            </span>

            <h3>Make Room for a Digital Detox</h3>

            <p>
                Our cottages are ideal for a digital detox.
                Take a break from constant notifications, screens and
                everyday distractions. Enjoy peaceful moments, reconnect
                with nature, spend quality time with loved ones and
                rediscover the simple pleasures of life.
            </p>

            <div class="rc-detox-features">

                <span>
                    <i class="bi bi-check-circle-fill"></i>
                    Switch off
                </span>

                <span>
                    <i class="bi bi-check-circle-fill"></i>
                    Relax and recharge
                </span>

                <span>
                    <i class="bi bi-check-circle-fill"></i>
                    Reconnect with nature
                </span>

            </div>

        </div>

    </section>


    <!-- Error Message -->
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rc-alert"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["error"]

            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Cottage Collection -->
    @if (!cottages.Any())
    {
        <div class="rc-empty-state">

            <div class="rc-empty-icon">
                <i class="bi bi-house-door"></i>
            </div>

            <h3>No Cottages Available</h3>

            <p>
                Our cottage collection is currently being updated.
                Please check back soon for your next getaway.
            </p>

        </div>
    }
    else
    {
        <!-- Cottage Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var cottage in cottages)
            {
                <div class="col">

                    <article class="rc-cottage-card h-100">

                        <!-- Image -->
                        <div class="rc-cottage-image-wrapper">

                            @if (!string.IsNullOrWhiteSpace(cottage.ImageUrl))
                            {
                                <img src="@cottage.ImageUrl"
                                     alt="@cottage.Name"
                                     class="rc-cottage-image"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="rc-cottage-placeholder">
                                    <i class="bi bi-house-heart"></i>
                                </div>
                            }

                            <div class="rc-image-shade"></div>

                            <!-- Price -->
                            <div class="rc-price-tag">
                                <strong>£@cottage.Rate.ToString("N0")</strong>
                                <span>per night</span>
                            </div>

                            <!-- Image Label -->
                            <div class="rc-image-label">
                                <i class="bi bi-gem"></i>
                                ROYALCOTTAGE
                            </div>

                        </div>


                        <!-- Card Body -->
                        <div class="rc-cottage-body">

                            <div class="rc-cottage-heading">

                                <div>
                                    <span class="rc-cottage-category">
                                        YOUR PRIVATE RETREAT
                                    </span>

                                    <h3 class="rc-cottage-title">
                                        @cottage.Name
                                    </h3>
                                </div>

                                <div class="rc-cottage-heading-icon">
                                    <i class="bi bi-house-heart"></i>
                                </div>

                            </div>


                            <!-- Description -->
                            <p class="rc-cottage-description">
                                @cottage.Details
                            </p>


                            <!-- Cottage Features -->
                            <div class="rc-cottage-features">

                                <div class="rc-feature-item">
                                    <i class="bi bi-people"></i>

                                    <div>
                                        <strong>@cottage.Occupancy</strong>
                                        <small>Guests</small>
                                    </div>
                                </div>

                                <div class="rc-feature-item">
                                    <i class="bi bi-arrows-fullscreen"></i>

                                    <div>
                                        <strong>@cottage.SqMeters m²</strong>
                                        <small>Living Space</small>
                                    </div>
                                </div>

                            </div>


                            <!-- Digital Detox Label -->
                            <div class="rc-cottage-detox">
                                <i class="bi bi-phone"></i>
                                <span>Ideal for a digital detox</span>
                            </div>


                            <!-- Contact Button -->
                            <div class="rc-cottage-footer">

                                <a href="#"
                                   class="rc-btn-cottage">

                                    <span>Enquire Now</span>
                                    <i class="bi bi-arrow-up-right"></i>

                                </a>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>


        <!-- Statistics -->
        <section class="rc-statistics-section">

            <div class="rc-statistics-heading">

                <span>ROYALCOTTAGE AT A GLANCE</span>

                <h2>Discover Our Collection</h2>

                <p>
                    Everything you need to find your perfect escape.
                </p>

            </div>

            <div class="row g-4">

                <!-- Total Cottages -->
                <div class="col-6 col-lg-3">
                    <div class="rc-stat-card">

                        <div class="rc-stat-icon">
                            <i class="bi bi-house-heart-fill"></i>
                        </div>

                        <h3>@totalCottages</h3>

                        <p>Available Cottages</p>

                    </div>
                </div>

                <!-- Starting Price -->
                <div class="col-6 col-lg-3">
                    <div class="rc-stat-card">

                        <div class="rc-stat-icon">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <h3>£@startingRate.ToString("N0")</h3>

                        <p>Starting From / Night</p>

                    </div>
                </div>

                <!-- Occupancy -->
                <div class="col-6 col-lg-3">
                    <div class="rc-stat-card">

                        <div class="rc-stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <h3>@maxOccupancy</h3>

                        <p>Maximum Guests</p>

                    </div>
                </div>

                <!-- Total Space -->
                <div class="col-6 col-lg-3">
                    <div class="rc-stat-card">

                        <div class="rc-stat-icon">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </div>

                        <h3>@totalSqMeters.ToString("N0") m²</h3>

                        <p>Total Living Space</p>

                    </div>
                </div>

            </div>

        </section>

    }

</div>
