@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Royal Cottage</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RoyalCottage_Web.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg luxury-navbar">
            <div class="container-fluid px-lg-5">

                <!-- BRAND -->
                <a class="navbar-brand luxury-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house-heart-fill me-2"></i>
                    <span>Royal <span class="brand-gold">Cottage</span></span>
                </a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT SIDE: HOME, COTTAGE MANAGEMENT, PRIVACY -->
                    <ul class="navbar-nav me-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Home
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Cottage"
                                   asp-action="Index">
                                    <i class="bi bi-houses me-1"></i>
                                    Cottage Management
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i>
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- RIGHT SIDE: LOGIN, REGISTER, CONTACT US -->
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="accountDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-person-circle me-1"></i>
                                    @User.Identity.Name
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="accountDropdown">

                                    <li>
                                        <form asp-controller="Auth"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Logout
                                            </button>

                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Register
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-contact"
                               href="mailto:hello@dotnetmastery.com">
                                <i class="bi bi-envelope me-1"></i>
                                Contact Us
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="luxury-footer">

        <div class="container-fluid px-lg-5">

            <div class="row gy-4 align-items-start">

                <!-- BRAND / DESCRIPTION -->
                <div class="col-lg-5 col-md-6">

                    <a class="footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-house-heart-fill me-2"></i>
                        Royal <span class="brand-gold">Cottage</span>

                    </a>

                    <p class="footer-description mt-3">
                        Discover beautiful cottages designed for relaxation,
                        comfort and unforgettable escapes. Take a break from
                        everyday life and reconnect with what matters.
                    </p>

                </div>

                <!-- QUICK LINKS -->
                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-heading">Quick Links</h5>

                    <ul class="footer-links">

                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Cottage" asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Cottages
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-chevron-right"></i>
                                Privacy Policy
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- CONTACT -->
                <div class="col-lg-4 col-md-6">

                    <h5 class="footer-heading">Get in Touch</h5>

                    <ul class="footer-links">

                        <li>
                            <a href="mailto:hello@dotnetmastery.com">
                                <i class="bi bi-envelope me-2"></i>
                                hello@dotnetmastery.com
                            </a>
                        </li>

                        <li>
                            <span>
                                <i class="bi bi-house-heart me-2"></i>
                                Your perfect countryside escape
                            </span>
                        </li>

                    </ul>

                </div>

            </div>

            <div class="footer-divider"></div>

            <!-- COPYRIGHT -->
            <div class="footer-bottom">

                <p class="footer-copyright mb-0">
                    &copy; @DateTime.Now.Year Royal Cottage.
                    All rights reserved.
                </p>

                <p class="footer-copyright mb-0">
                    Designed for relaxation and memorable escapes.
                </p>

            </div>

        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
